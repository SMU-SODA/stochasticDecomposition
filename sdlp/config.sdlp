// absolute path to input directory
INPUTDIR	../spInput/

// absolute path to output directory
OUTPUTDIR	../../spOutput/

// Maximum number of iterations
MAX_ITER   5000

// Minimum iterations
MIN_ITER   1

// Tolerance level used to differentiate floating point numbers */
TOLERANCE    0.00001

// Flag to indicate how forward decision simulation problems are solved. 0 for LP/1 for QP.
QUADRATIC	1

// The Minimum value of the cell->quad_scalar. zl
MIN_QUAD_SCALAR 0.001

// The Maximum value of the cell->quad_scalar. zl
MAX_QUAD_SCALAR 10000.0

// Amount of improvement which must be observed in order to update incumbent X.
R1 0.2

// For updating the scaling factor.
R2 0.95

// For updating the scaling factor.
R3 2

// Determines the policy employed to select incumbent: Fixed - 0, Scenario-dependent - 1, linear mapping - 2
POLICY	0

// Run seed
RUN_SEED	9495518635394380

// Indicate whether to employ (by setting equal to 1) evaluation of the eventual solution
EVAL_FLAG 0

// Random number seed for resampling omegas during evaluation
EVAL_SEED	1354874229869110

// Obj. eval. is accurate to within this much, w/95% confidence
EVAL_ERROR 0.01

// Optimality gap (relative to the mean value)
OPT_GAP	0.01

// Number of resampling to take when checking optimality.
M 50

// Ratio used in pre_test for optimality: (Sm - Lm) / Fk  < PRE_EPSILON.
PRE_EPSILON 0.01

// Number of iterations before checking new pi's impact
PI_EVAL_START 1

// Number of iterations between evaluation of the impact of new dual vertex
PI_CYCLE 1

// NOMINAL TOLERANCE 256
SCAN_LEN 64